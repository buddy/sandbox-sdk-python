# Buddy API credentials used by the test suite and the examples
BUDDY_TOKEN=
BUDDY_WORKSPACE=

# Project the tests create their sandboxes in
BUDDY_PROJECT=

# Environment for sandboxes instead of a project. Leave this unset: the SDK
# reads it itself, and it would move every example into that environment.
# BUDDY_ENVIRONMENT=

# Optional: US (default), EU or AS
# BUDDY_REGION=US

# Optional: point the SDK at another API, e.g. a local one
# BUDDY_API_URL=https://api.buddy.works

# Optional: debug, info, warn (default), error, silent
# BUDDY_LOGGER_LEVEL=

# Skip TLS verification for a local API with a self-signed certificate.
# Local development only.
# BUDDY_TLS_REJECT_UNAUTHORIZED=0

# Used only by the test suite: each scope suite skips when its variables
# are missing
# BUDDY_TEST_WORKSPACE=
# BUDDY_TEST_PROJECT=
# BUDDY_TEST_ENVIRONMENT=
# BUDDY_TEST_PROJECT_ENVIRONMENT=
